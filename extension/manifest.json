{
  "manifest_version": 3,
  "name": "NeuroTune",
  "version": "1.0",
  "description": "Control the playback speed of audio and video on the active webpage.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open NeuroTune"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
